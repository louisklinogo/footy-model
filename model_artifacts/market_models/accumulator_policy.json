{
  "slip_size_default": 3,
  "slip_size_allow_4": false,
  "max_tickets_per_day": 1,
  "stake_fraction_per_ticket": 0.01,
  "daily_stop_loss_fraction": 0.03,
  "min_leg_p_conservative": 0.82,
  "min_leg_edge_adjusted": 0.03,
  "max_leg_risk_score": 50,
  "per_leg_odds_min": 1.25,
  "per_leg_odds_max": 1.75,
  "ticket_total_odds_min": 2.2,
  "ticket_total_odds_max": 4.5,
  "odds_snapshot_preference": [
    "latest_pre_match",
    "closing"
  ],
  "allow_missing_odds": false,
  "market_gating_path": "model_artifacts/market_models/market_gating.json",
  "correlation_policy": {
    "forbid_same_fixture": true,
    "forbid_same_team_across_legs": true,
    "max_legs_per_league": 2,
    "same_league_probability_haircut": 0.97,
    "p_ticket_formula_default": "prod(p_leg_conservative) * (same_league_probability_haircut ** extra_same_league_legs)"
  },
  "ticket_hit_rate_floor_target": 0.6,
  "ticket_hit_rate_stretch_target": 0.8,
  "odds_time_integrity": {
    "require_snapshot_le_kickoff": true,
    "allow_closing_if_pre_kickoff": true,
    "closing_adds_risk_flag": true
  }
}
